{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gonashc/Evidence-linked-engineering-signal-triage-agent/schemas/triage_group.schema.json",
  "title": "Triage issue group",
  "description": "One evidence-linked issue group produced by the signal-triage skill. Rules live in docs/rubric.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id", "severity", "category", "title", "what_breaks", "rationale", "next_check",
    "reports", "linked_groups", "regression", "status_from_comments", "needs_info", "evidence_quotes"
  ],
  "properties": {
    "group_id": { "type": "string", "pattern": "^G[0-9]{3}$" },
    "severity": { "enum": ["S1", "S2", "S3", "S4", null] },
    "category": { "enum": ["bug", "upstream", "needs info", "feature request", "docs", "support question"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "what_breaks": { "type": "string", "minLength": 1, "maxLength": 300 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 300 },
    "next_check": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "url"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^(angular|angular-cli|components)#[0-9]+$" },
          "url": { "type": "string", "pattern": "^https://github\\.com/angular/(angular|angular-cli|components)/issues/[0-9]+(#issuecomment-[0-9]+)?$" }
        }
      }
    },
    "linked_groups": { "type": "array", "items": { "type": "string", "pattern": "^G[0-9]{3}$" }, "uniqueItems": true },
    "regression": { "enum": ["yes", "no", "unclear", ""] },
    "status_from_comments": { "type": "string", "maxLength": 200 },
    "needs_info": { "type": "boolean" },
    "evidence_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "quote"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^(angular|angular-cli|components)#[0-9]+$" },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "enum": ["feature request", "docs", "support question"] } } },
      "then": { "properties": { "severity": { "const": null } } }
    },
    {
      "if": { "properties": { "category": { "const": "needs info" } } },
      "then": { "properties": { "needs_info": { "const": true } } }
    }
  ]
}
